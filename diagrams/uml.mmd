classDiagram
    %% PawPal+ first draft (Phase 1). See uml_final.mmd for the version that matches the code.

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) Pet
        +get_pet(name) Pet
        +all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) Task
        +list_tasks() list~Task~
        +pending_tasks() list~Task~
        +complete_task(task) Task
    }

    class Task {
        +str description
        +str time
        +date due_date
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +str pet_name
        +mark_complete()
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_by_pet(name) list~Task~
        +filter_by_status(completed) list~Task~
        +detect_conflicts() list~str~
        +mark_task_complete(task) Task
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : reads pets and tasks
