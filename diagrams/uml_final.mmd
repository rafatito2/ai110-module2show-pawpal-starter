classDiagram
    %% PawPal+ final design. Matches pawpal_system.py.

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) Pet
        +get_pet(name) Pet
        +all_tasks() list~Task~
        +to_dict() dict
        +from_dict(data) Owner
        +save_to_json(path) str
        +load_from_json(path) Owner
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) Task
        +list_tasks() list~Task~
        +pending_tasks() list~Task~
        +remove_task(task)
        +complete_task(task) Task
        +to_dict() dict
        +from_dict(data) Pet
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete()
        +start_minutes() int
        +end_minutes() int
        +next_occurrence() Task
        +to_dict() dict
        +from_dict(data) Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +todays_schedule(day) list~Task~
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_by_pet(name, tasks) list~Task~
        +filter_by_status(completed, tasks) list~Task~
        +filter_by_priority(priority, tasks) list~Task~
        +detect_conflicts(day) list~str~
        +next_available_slot(duration, day) str
        +build_daily_plan(available_minutes, day) dict
        +mark_task_complete(task) Task
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : reads all pets' tasks
    Scheduler ..> Pet : delegates complete_task
    Task ..> Task : next_occurrence() creates copy
